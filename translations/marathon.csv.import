[remap]

importer="csv_translation"
type="Translation"

[deps]

files=["res://translations/marathon.de.translation", "res://translations/marathon.en.translation"]

source_file="res://translations/marathon.csv"
dest_files=["res://translations/marathon.de.translation", "res://translations/marathon.en.translation"]

[params]

compress=1
delimiter=0
unescape_keys=false
unescape_translations=true
