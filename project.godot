; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TETHRA"
config/use_custom_user_dir=true
config/custom_user_dir_name="omen_cl_test"
config/description="3D-Tunnel-Rhythm-Game. Liest osu!-Beatmaps."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.071, 0.067, 0.063, 1)
boot_splash/image="res://assets_game/ui/boot_splash.png"
boot_splash/show_image=true

[autoload]

WorldPack="*res://scripts/net/world_pack.gd"
SyncClock="*res://scripts/audio/sync_clock.gd"
GameSession="*res://scripts/game_session.gd"
GpuGuard="*res://scripts/core/gpu_guard.gd"
Settings="*res://scripts/settings.gd"
Lobby="*res://scripts/net/lobby.gd"
Mirror="*res://scripts/net/beatmap_mirror.gd"
Updater="*res://scripts/net/updater.gd"
SceneFader="*res://scripts/ui/scene_fader.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[input]

hook={
"deadzone": 0.5,
"events": [{
"button_index": 1,
"device": -1,
"type": "InputEventMouseButton"
}]
}
hook_alt={
"deadzone": 0.5,
"events": [{
"button_index": 2,
"device": -1,
"type": "InputEventMouseButton"
}]
}

[input_devices]

buffering/agile_event_flushing=true

[audio]

driver/mix_rate=48000

[internationalization]

locale/translations=PackedStringArray("res://translations/menus.en.translation", "res://translations/game.en.translation", "res://translations/mp.en.translation", "res://translations/colors.en.translation", "res://translations/lobby.en.translation", "res://translations/tourskip.en.translation", "res://translations/picker.en.translation", "res://translations/gpu.en.translation", "res://translations/stats.en.translation", "res://translations/clip.en.translation", "res://translations/scroll.en.translation", "res://translations/orbit.en.translation", "res://translations/scores.en.translation", "res://translations/mania2d.en.translation", "res://translations/lobbycraft.en.translation", "res://translations/settings2.en.translation", "res://translations/results_detail.en.translation", "res://translations/song_import.en.translation", "res://translations/browser_filters.en.translation", "res://translations/online.en.translation", "res://translations/mp_relay.en.translation", "res://translations/fail.en.translation", "res://translations/chat.en.translation", "res://translations/orbit_career.en.translation", "res://translations/modes.en.translation", "res://translations/rally.en.translation", "res://translations/rally.de.translation", "res://translations/dirigent.en.translation", "res://translations/trace.en.translation", "res://translations/trace.de.translation", "res://translations/rebound.en.translation", "res://translations/rebound.de.translation", "res://translations/dirigent.de.translation", "res://translations/orbit.de.translation", "res://translations/settings2.de.translation", "res://translations/polish.en.translation", "res://translations/polish.de.translation", "res://translations/campaign.en.translation", "res://translations/campaign.de.translation")
locale/fallback="de"

[physics]

common/physics_ticks_per_second=240
common/max_physics_steps_per_frame=16

[rendering]

rendering_device/fallback_to_opengl3=true
textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_2d=3
anti_aliasing/quality/msaa_3d=3
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
