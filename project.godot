; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="TETHRA"
config/description="3D-Tunnel-Rhythm-Game. Liest osu!-Beatmaps."
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

WorldPack="*res://scripts/net/world_pack.gd"
SyncClock="*res://scripts/audio/sync_clock.gd"
GameSession="*res://scripts/game_session.gd"
Settings="*res://scripts/settings.gd"
Lobby="*res://scripts/net/lobby.gd"
Mirror="*res://scripts/net/beatmap_mirror.gd"
Updater="*res://scripts/net/updater.gd"
SceneFader="*res://scripts/ui/scene_fader.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720

[input]

hook={
"deadzone": 0.5,
"events": [{
"button_index": 1,
"device": -1,
"type": "InputEventMouseButton"
}]
}
hook_alt={
"deadzone": 0.5,
"events": [{
"button_index": 2,
"device": -1,
"type": "InputEventMouseButton"
}]
}

[input_devices]

buffering/agile_event_flushing=true

[audio]

driver/mix_rate=48000

[internationalization]

locale/translations=PackedStringArray("res://translations/menus.en.translation", "res://translations/game.en.translation", "res://translations/mp.en.translation", "res://translations/colors.en.translation", "res://translations/lobby.en.translation", "res://translations/tourskip.en.translation")
locale/fallback="de"

[physics]

common/physics_ticks_per_second=240
common/max_physics_steps_per_frame=16

[rendering]

textures/default_filters/anisotropic_filtering_level=4
anti_aliasing/quality/msaa_2d=3
anti_aliasing/quality/msaa_3d=3
anti_aliasing/quality/use_debanding=true
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
